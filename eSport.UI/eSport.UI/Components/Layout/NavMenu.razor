    // {
    //     if (firstRender)
    //     {
    //         jsModule = await JS.InvokeAsync<IJSObjectReference>(
    //                  "import", "./Components/Layout/NavMenu.razor.js");

    //     }

    // }
}
<style>
    nav .account.open > ul {
        display: block;
    }
</style>