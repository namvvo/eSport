<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <GraphQL Remove="GraphQL\Catalog\currentRoundLeagueCalendar.graphql" />
    <GraphQL Remove="GraphQL\League\leaguePlayerStats.graphql" />
    <GraphQL Remove="GraphQL\League\recentFixtures.graphql" />
    <GraphQL Remove="GraphQL\League\topLeaguePlayerStats.graphql" />
    <GraphQL Remove="GraphQL\MatchCentre\standingsByCategory.graphql" />
    <GraphQL Remove="GraphQL\MatchCentre\teamsStatsByLeague.graphql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.10" />
    <PackageReference Include="StrawberryShake.Blazor" Version="16.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\eSport.UI.Shared\eSport.UI.Shared.csproj" />
  </ItemGroup>

</Project>
