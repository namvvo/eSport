<div class="grid lg:grid-cols-12">
    @if (currentSeason != null &&
    currentSeason?.ActiveSeasonStage.SeasonStageId > 0)
    {
        <UseTopLeaguePlayersStats Context="result" Strategy="ExecutionStrategy.CacheAndNetwork"
                                  Filter="_filter">
            <ChildContent>
                @{

                    var stats = result.TopLeaguePlayersStats;//.Adapt<TopPlayerStatsDto>();
                }

                <StatsTemplate RowHeaderTitle="Rê bóng"
                               Css="stat-bar-wrapper value"
                               Width="w70"
                               DivCss="col-span-4"
                               IsPercentageValue=true
                               IsPLayer=true
                               Items="stats.Dribble"
                               GetName="x=>x.Player.Name"
                               GetSeName="x => x.Player.Slug"
                               GetInfo="x => x.Info">
                </StatsTemplate>
                <div class="col-span-4" v-if="stats && stats.aggression">
                    <table class="striped">
                        <thead>
                            <tr>
                                <th class="stat-title" colspan="3">Phạm lỗi</th>
                            </tr>
                        </thead>
                        <tbody>
                              @foreach (var item in stats.Aggression)
                            {
                                <tr v-for="item in stats?.aggression" :key="item.name">
                                    <td class="list-key">
                                        <NavLink class="team-link" href="@($"cauthu/{item.Player.Slug}")" title="@item.Player.Name">
                                            @item.Player.Name
                                        </NavLink>
                                    </td>
                                    <td>
                                        <span class="stat-value number yellow-card-box">@item.Info</span>
                                    </td>
                                    <td>
                                        <span class="stat-value number red-card-box">@item.Info2</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <StatsTemplate RowHeaderTitle="Kiến tạo ghi bàn"
                               Css="stat-bar-wrapper"
                               Width="w70"
                               DivCss="col-span-4"
                               IsPercentageValue=true
                               IsPLayer=true
                               Items="stats.Assist"
                               GetName="x=>x.Player.Name"
                               GetSeName="x => x.Player.Slug"
                               GetInfo="x => x.Info">
                </StatsTemplate>
                <StatsTemplate RowHeaderTitle="Shoot mỗi trận"
                               Css="stat-bar-wrapper value"
                               Width="w70"
                               DivCss="col-span-4"
                               IsPercentageValue=true
                               IsPLayer=true
                               Items="stats.ShotsPerGame"
                               GetName="x=>x.Player.Name"
                               GetSeName="x => x.Player.Slug"
                               GetInfo="x => x.Info">
                </StatsTemplate>
                <StatsTemplate RowHeaderTitle="Chuyền chính xác"
                               Css="stat-bar-wrapper"
                               Width="w70"
                               DivCss="col-span-4"
                               IsPercentageValue=true
                               IsPLayer=true
                               Items="stats.PassAccuracy"
                               GetName="x=>x.Player.Name"
                               GetSeName="x => x.Player.Slug"
                               GetInfo="x => x.Info">
                </StatsTemplate>
                <StatsTemplate RowHeaderTitle="Điểm đánh giá"
                               Css="stat-value number rating"
                               Width=""
                               DivCss="col-span-4"
                               IsPercentageValue=false
                               IsPLayer=true
                               Items="stats.Ratings"
                               GetName="x=>x.Player.Name"
                               GetSeName="x => x.Player.Slug"
                               GetInfo="x => x.Info">
                </StatsTemplate>
 

            </ChildContent>
        </UseTopLeaguePlayersStats>
    }
</div>
@code {
    [Parameter]
    public CurrentSeasonModel? currentSeason { get; set; }
    private LeaguePlayerStatsFilterInput _filter = new();
    protected override void OnParametersSet()
    {

        if (currentSeason?.ActiveSeasonStage is null)
            return;
        _filter = new()
        {
            CategoryIds = new[] { currentSeason?.SelectedCatId ?? 0 },
            SeasonStageIds = currentSeason!.ActiveSeasonStage.SeasonStageId,
            PageIndex = 0,
            PageSize = 30,
            CountApp = 0,
            TeamId = 0,
            TeamPosition = ""
        };

    }
}
