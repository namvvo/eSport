<div class="grid-toolbar">
    <dl class="listbox">
        <dt>Lọc:</dt>
        @foreach (var item in teamStandingFilter)
        {
            <dd v-for="item in teamStandingFilter" :key="item.id">
                <span @onclick="(()=>ChangeTeamStandingFilter(item.Id))" :class="{ selected: item.selected }" class="option">
                    @item.Name
                </span>
            </dd>
        }
    </dl>
   @*  <UseStandingsByCategory Context="result"
                            SeasonStageId="@(currentSeason?.ActiveSeasonStage.SeasonStageId??0)"
                            CategoryId="@(currentSeason?.SelectedCatId??0)"
                            FilterBy="@selectedFilterTeamStanding"
                            Strategy="ExecutionStrategy.NetworkOnly">
        <ChildContent>
            <TeamTable teamStandingByCategory="@(result.StandingsByCategory)"
                       selectedFilterTeamStanding="@selectedFilterTeamStanding" />
        </ChildContent>
        <ErrorContent>
            Something went wrong ...<br />
            @result.First().Message
        </ErrorContent>
        <LoadingContent>
            Loading
        </LoadingContent>
    </UseStandingsByCategory> *@

</div>

@code {

    private IList<FilterModel> teamStandingFilter = new List<FilterModel>();

    [Parameter]
    public CurrentSeasonModel? currentSeason { get; set; }

    public int selectedFilterTeamStanding { get; set; } = 0;
    protected override Task OnInitializedAsync()
    {

        teamStandingFilter.Add(new FilterModel() { Name = "Tổng quan", Selected = true, Id = 0 });
        teamStandingFilter.Add(new FilterModel() { Name = "Sân nhà", Selected = false, Id = 1 });
        teamStandingFilter.Add(new FilterModel() { Name = "Sân khách", Selected = false, Id = 2 });
        // return await Task.FromResult();

        return base.OnInitializedAsync();
    }

    // public override Task SetParametersAsync(ParameterView parameters)
    // {
    //     parameters.SetParameterProperties(parameters);

    //     // Before we do any rendering check to make sure that Value is set and throw an exception if it's not
    //     // This will only normally occur during Development
    //     ArgumentNullException.ThrowIfNull(currentSeason);

    //     return base.SetParametersAsync(ParameterView.Empty);
    // }
    private void ChangeTeamStandingFilter(int filter)
    {
        var selectedFilterItem = teamStandingFilter.FirstOrDefault(f => f.Id == filter);
        teamStandingFilter.ToList().ForEach(x => x.Selected = false);

        ChangeTeamStandings(filter);
    }
    private void ChangeTeamStandings(int filter)
    {
        this.selectedFilterTeamStanding = filter;
        StateHasChanged();
    }
}
